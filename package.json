{
  "name": "finsim",
  "version": "1.0.0",
  "description": "FinSim - Simulador de financiación: motor de cálculo compartido + interfaces web y móvil",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "nx run @finsim/web-react:dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "ejemplo": "npm run ejemplo -w @finsim/core"
  },
  "keywords": [
    "financiacion",
    "tae",
    "prestamo",
    "amortizacion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nx": "^24.0.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
