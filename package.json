{
  "name": "finsim",
  "version": "1.0.0",
  "description": "FinSim - Simulador de financiación: motor de cálculo compartido + interfaces web y móvil",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "nx run @finsim/web:serve",
    "preview": "nx run @finsim/web:preview",
    "ios": "nx run @finsim/mobile:ios",
    "android": "nx run @finsim/mobile:android",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "ejemplo": "npm run ejemplo -w @finsim/core"
  },
  "keywords": [
    "financiacion",
    "tae",
    "prestamo",
    "amortizacion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.5",
    "@angular-devkit/core": "~22.2.5",
    "@angular-devkit/schematics": "~22.2.5",
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@nx/angular": "^24.0.3",
    "@nx/js": "24.0.3",
    "@nx/web": "24.0.3",
    "@schematics/angular": "~22.2.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "jsdom": "^29.1.1",
    "nx": "^24.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/router": "~22.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
