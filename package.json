{
  "name": "finsim",
  "version": "1.0.0",
  "description": "FinSim - Simulador de financiación: motor de cálculo compartido + interfaces web y móvil",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "nx run @finsim/web-react:dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "ejemplo": "npm run ejemplo -w @finsim/core"
  },
  "keywords": [
    "financiacion",
    "tae",
    "prestamo",
    "amortizacion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@angular/compiler-cli": "~22.2.4",
    "@types/node": "^26.6.6",
    "nx": "^24.0.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "xlsx": "^0.18.5"
  }
}
